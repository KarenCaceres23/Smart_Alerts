# Archivo de ejemplo para pruebas de integración

# TELEGRAM (Usa credenciales de prueba, NO el bot de producción principal si no quieres mezclar)
TELEGRAM_BOT_TOKEN=reemplaza_con_tu_token_real
TELEGRAM_CHAT_ID=reemplaza_con_tu_chat_id_real

# INFLUXDB (Valores fijos que coinciden con compose.integration.yml)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=integration-token-12345
INFLUXDB_ORG=smart_org
INFLUXDB_BUCKET=smart_bucket
INFLUXDB_MEASUREMENT=water_flow

# AJUSTES DE ALERTA PARA INTEGRACIÓN
ALERT_COOLDOWN_SECONDS=60
ALERT_DEBOUNCE_SECONDS=5

# OTRAS CONFIGURACIONES
APP_TIMEZONE=America/El_Salvador
AUDIT_LOG_PATH=audit_integration.jsonl
LOG_LEVEL=DEBUG
